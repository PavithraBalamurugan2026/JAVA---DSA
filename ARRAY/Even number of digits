class Solution {
    public int findNumbers(int[] nums) {
        int digitcount = 0;
        int totalcount = 0;
        for(int i = 0; i < nums.length; i++){
            digitcount = 0;
            int temp = nums[i];
            while(temp > 0){
                temp = temp / 10;
                digitcount++;
            }
            if(digitcount % 2 == 0){
                totalcount++;
            }
        }
        return totalcount;
    }
}
