class Solution {
    public boolean uniqueOccurrences(int[] arr) {
        int count = 0;
        int c = 0;
        int[] unique = new int[arr.length];
        int occur = 0;
        int[] occurences = new int[arr.length];
        for(int i = 0; i < arr.length; i++){
            boolean isfound = false;
            for(int k = 0; k < c; k++){
                if(arr[i] == unique[k]){
                    isfound = true;
                    break;
                } 
            }
            if (isfound) {
                continue;
            }
            for(int j = i; j < arr.length; j++){
                if(arr[i] == arr[j]){
                    count++;
                }
            }
            unique[c] = arr[i];
            c++;
            occurences[occur] = count;
            occur++;
            count = 0;
        }
        for(int i = 0; i < occur; i++){
            for(int j = i + 1; j < occur; j++){
                if(occurences[i] == occurences[j]){
                    return false;
                }
            }
        }
        return true;
    }
}
