class Solution {
    public int diagonalSum(int[][] mat) {
        int sum = 0;
        int n = mat[0].length;
        for(int i = 0; i < mat.length; i++){
            int primediagonal = mat[i][i];
            int secondarydiagonal = mat[i][n - 1 - i];
            if(i != n - 1 - i){sum += primediagonal + secondarydiagonal;}
            else{sum += primediagonal;}
        }
        return sum;
    }
}
