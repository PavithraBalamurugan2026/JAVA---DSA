class Solution {
    public int removeDuplicates(int[] nums) {
        if (nums.length <= 2) {
            return nums.length;
        }
        int ins = 2; 
        for (int i = 2; i < nums.length; i++) {
            if (nums[i] != nums[ins - 2]) {
                nums[ins] = nums[i];
                ins++;
            }
        }
        return ins;
    }
}
