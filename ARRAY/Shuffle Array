class Solution {
    public int[] shuffle(int[] nums, int n) {
        int[] ans = new int[nums.length];
        int count = 0;
        int i = 0, j = n;
        while(i < n){
            ans[count] = nums[i];
            count += 1;
            ans[count] = nums[j];
            count += 1;
            i++;
            j++;
        }
        return ans;
    }
}
