class Solution {
    public int pivotIndex(int[] nums) {
        int total = 0;
        int leftsum = 0;
        int rightsum = 0;
        for(int num : nums){
            total += num;
        }
        for(int i = 0; i < nums.length; i++){
            if(i > 0){
                leftsum += nums[i-1];
            }
            rightsum = total - leftsum - nums[i];
            if(leftsum == rightsum){
                return i;
            }
        }
        return -1;
    }
}
