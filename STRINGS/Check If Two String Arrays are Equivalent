class Solution {
    public boolean arrayStringsAreEqual(String[] word1, String[] word2) {
        String firstword = "";
        String secondword = "";
        for(int i = 0; i < word1.length; i++){
            firstword += word1[i];
        }
        for(int i = 0; i < word2.length; i++){
            secondword += word2[i];
        }
        if(firstword.equals(secondword)){
            return true;
        }
        return false;
    }
}
